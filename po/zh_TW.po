#: libvirt-gobject/libvirt-gobject-connection.c:1073
msgid "Connection is not opened"
msgstr "連線尚未開啟"

#: libvirt-gobject/libvirt-gobject-connection.c:1394
#: libvirt-gobject/libvirt-gobject-connection.c:1449
