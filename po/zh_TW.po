msgstr "無法建立 domain"

#: libvirt-gobject/libvirt-gobject-connection.c:2020
msgid "Failed to create storage pool"
msgstr "無法建立 storage pool"

#: libvirt-gobject/libvirt-gobject-connection.c:742
